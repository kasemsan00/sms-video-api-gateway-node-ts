{
  "name": "backend",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:old": "set NODE_ENV=development && nodemon index.js",
    "build": "npm run clean && tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "build:production": "npm run clean && npm run typecheck && npm run lint && tsc && tsc-alias",
    "clean": "rimraf dist",
    "test": "set NODE_ENV=test && vitest run",
    "test:watch": "set NODE_ENV=test && vitest",
    "test:coverage": "set NODE_ENV=test && vitest run --coverage",
    "test:unit": "set NODE_ENV=test && vitest run --dir src/tests/unit",
    "test:integration": "set NODE_ENV=test && vitest run --dir src/tests/integration",
    "test:e2e": "set NODE_ENV=test && vitest run --dir src/tests/e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "validate": "npm run typecheck && npm run lint && npm run format:check",
    "prepare": "npm run build",
    "prestart": "npm run build",
    "deploy": "sh deploy.sh",
    "db:seed": "tsx src/infrastructure/database/seeds/index.ts",
    "db:test": "tsx src/infrastructure/database/mysql/connection.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@benborla29/mcp-server-mysql": "^1.0.7",
    "cors": "^2.8.5",
    "cron": "^3.5.0",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "get-video-duration": "^4.1.0",
    "http-proxy-middleware": "^2.0.6",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.13.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "nanoid": "^5.0.9",
    "randomstring": "^1.3.1",
    "reflect-metadata": "^0.2.2",
    "rotating-file-stream": "^3.2.7",
    "serve-index": "^1.9.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "sqlstring": "^2.3.3",
    "tsyringe": "^4.10.0",
    "ua-parser-js": "^2.0.0",
    "winston": "^3.17.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.24.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.2",
    "@types/randomstring": "^1.3.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "eslint": "^8.6.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx": "^0.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^3.1.9",
    "prettier": "3.5.3",
    "supertest": "^6.3.4",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "volta": {
    "node": "22.15.1"
  }
}
